# ====================================================================
# InstantShare Backend - Environment Variables
# Copy to .env or export in your environment
# ====================================================================

# MySQL Database Connection
MYSQL_DB_URL=jdbc:mysql://localhost:3306/instantshare?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=instantshare
MYSQL_DB_USERNAME=root
MYSQL_DB_PASSWORD=your_mysql_password

# JWT Authentication Secret (Must be 32+ characters)
JWT_SECRET=InstantShareSecureJwtSecretKeyForHyperlocalMarketplaceMustBeAtLeast32BytesLong

# Payment Gateway Configuration
# Runs in DEMO mode by default - zero external accounts or cards needed!
PAYMENT_MODE=DEMO

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
