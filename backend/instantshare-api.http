### ====================================================================
### InstantShare - IntelliJ IDEA & REST Client Interactive HTTP Requests
### ====================================================================

@baseUrl = http://localhost:8080/api

### --------------------------------------------------------------------
### 1. AUTHENTICATION
### --------------------------------------------------------------------

### 1.1 Login as Renter (Abhimanyu)
# @name loginRenter
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "renter@instantshare.test",
  "password": "password123"
}

> {%
    client.global.set("renterToken", response.body.data.token);
    client.global.set("renterId", response.body.data.userId);
%}

### 1.2 Login as Owner 1 (Anshuman - Owns Drill at 63m)
# @name loginOwner
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "owner1@instantshare.test",
  "password": "password123"
}

> {%
    client.global.set("ownerToken", response.body.data.token);
    client.global.set("ownerId", response.body.data.userId);
%}

### 1.3 Register New User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Kabir Mehta",
  "email": "kabir@instantshare.test",
  "password": "password123",
  "phone": "+919988776655",
  "role": "RENTER"
}

### --------------------------------------------------------------------
### 2. USER PROFILE
### --------------------------------------------------------------------

### 2.1 Get Current Renter Profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{renterToken}}

### 2.2 Update Profile
PUT {{baseUrl}}/users/me
Authorization: Bearer {{renterToken}}
Content-Type: application/json

{
  "name": "Abhimanyu Agnivanshi",
  "phone": "+919876543212"
}

### --------------------------------------------------------------------
### 3. CATEGORIES & HYPERLOCAL GPS SEARCH (ZERO EXTERNAL MAP API)
### --------------------------------------------------------------------

### 3.1 List All Active Categories
GET {{baseUrl}}/categories

### 3.2 Nearby Search - 100m Radius (Expects only Drill at ~63m)
GET {{baseUrl}}/equipment/nearby?lat=12.914142&lon=77.636928&radius=100

### 3.3 Nearby Search - 200m Radius (Expects Drill at ~63m and Ladder at ~158m)
GET {{baseUrl}}/equipment/nearby?lat=12.914142&lon=77.636928&radius=200

### 3.4 Nearby Search - 300m Radius (Expects Drill, Ladder, and Camera at ~234m)
GET {{baseUrl}}/equipment/nearby?lat=12.914142&lon=77.636928&radius=300

### --------------------------------------------------------------------
### 4. EQUIPMENT CRUD
### --------------------------------------------------------------------

### 4.1 Get Equipment Details by ID
GET {{baseUrl}}/equipment/1

### 4.2 Create New Equipment Listing (Owner)
POST {{baseUrl}}/equipment
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "title": "Bosch Professional Angle Grinder 850W",
  "description": "High durability 100mm angle grinder for stone and metal cutting.",
  "categoryId": 1,
  "price": 180.00,
  "priceUnit": "DAY",
  "securityDeposit": 600.00,
  "latitude": 12.914250,
  "longitude": 77.637150,
  "displayArea": "Sector 1, HSR Layout (Near 7th Cross)",
  "imageUrls": [
    "https://images.unsplash.com/photo-1504148455328-c376907d081c"
  ]
}

### 4.3 List My Equipment Listings (Owner)
GET {{baseUrl}}/equipment/my
Authorization: Bearer {{ownerToken}}

### --------------------------------------------------------------------
### 5. RENTAL LIFECYCLE & DEMO PAYMENT WORKFLOW
### --------------------------------------------------------------------

### 5.1 Renter Submits Rental Request
# @name createRental
POST {{baseUrl}}/rentals
Authorization: Bearer {{renterToken}}
Content-Type: application/json

{
  "equipmentId": 1,
  "startAt": "2026-11-20T10:00:00Z",
  "endAt": "2026-11-21T10:00:00Z"
}

> {%
    client.global.set("rentalId", response.body.data.id);
%}

### 5.2 Owner Accepts the Rental Request
PATCH {{baseUrl}}/rentals/{{rentalId}}/decision
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "decision": "ACCEPT",
  "note": "Ready for collection at 10 AM."
}

### 5.3 Renter Initiates Demo Checkout
# @name checkoutSession
POST {{baseUrl}}/payments/checkout
Authorization: Bearer {{renterToken}}
Content-Type: application/json

{
  "rentalId": {{rentalId}}
}

> {%
    client.global.set("orderId", response.body.data.orderId);
%}

### 5.4 Renter Confirms Demo Payment (Instant Approval -> CONFIRMED)
POST {{baseUrl}}/payments/demo-confirm
Authorization: Bearer {{renterToken}}
Content-Type: application/json

{
  "rentalId": {{rentalId}},
  "orderId": "{{orderId}}",
  "cardNumber": "4242 4242 4242 4242",
  "expiry": "12/28",
  "cvv": "123",
  "simulateFailure": false
}

### 5.5 Check Payment Status for Rental
GET {{baseUrl}}/payments/status/{{rentalId}}
Authorization: Bearer {{renterToken}}

### 5.6 Owner Hands Over Equipment (Changes status to ACTIVE)
PATCH {{baseUrl}}/rentals/{{rentalId}}/handover
Authorization: Bearer {{ownerToken}}

### 5.7 Owner Inspects & Confirms Return (Changes status to COMPLETED)
PATCH {{baseUrl}}/rentals/{{rentalId}}/return
Authorization: Bearer {{ownerToken}}

### --------------------------------------------------------------------
### 6. REVIEWS
### --------------------------------------------------------------------

### 6.1 Renter Submits Review for Completed Rental
POST {{baseUrl}}/reviews
Authorization: Bearer {{renterToken}}
Content-Type: application/json

{
  "rentalId": {{rentalId}},
  "rating": 5,
  "comment": "Super convenient to rent within walking distance! Drill was in perfect condition."
}

### 6.2 Get Owner's Public Reviews
GET {{baseUrl}}/reviews/user/1
